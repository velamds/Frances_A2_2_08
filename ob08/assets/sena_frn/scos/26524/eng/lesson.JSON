 "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "frn5le08ob08re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Comment faire une dissertation ? Faisons des recherches ! ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation. ", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn5le08ob08re2img06.jpg"}, {"text": "<span class=\"strong\">Coraline</span> : Quel est le probl\u00e8me ? Tu as l'air contrari\u00e9 ! </br>\n<span class=\"strong\">Pierre</span> : J'ai une dissertation \u00e0 finir pour l'un de mes cours. J'ai cinq pages \u00e0 \u00e9crire et je manque cruellement de temps.</br>\n<span class=\"strong\">Coraline</span> : Tu as l'air stress\u00e9.", "id": 1, "time": "100", "image": "frn5le08ob08re2img06.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : Entre le travail et les cours, je n'arrive plus \u00e0 m'en sortir.</br>\n<span class=\"strong\">Coraline</span> : Il faut que tu prennes soin de toi. Il m'arrive de ressentir la m\u00eame chose \u00e0 l'\u00e9cole de cuisine.</br>\n<span class=\"strong\">Pierre</span> : Oui, et tu ne travaillais pas en m\u00eame temps. Ma dissertation me prend beaucoup de temps.</br>\n<span class=\"strong\">Coraline</span> : Tu veux des conseils ?</br>\n<span class=\"strong\">Pierre</span> : Bien s\u00fbr !", "id": 2, "time": "8800", "image": "frn5le08ob08re2img06.jpg"}, {"text": "<span class=\"strong\">Coraline</span> : Va te balader au parc et lib\u00e8re-toi l'esprit.</br>\n<span class=\"strong\">Pierre</span> : Ok.</br>\n<span class=\"strong\">Coraline</span> : Ensuite, rentre chez toi et prend une bonne douche, \u00e7a t'aidera \u00e0 te d\u00e9tendre.</br>\n<span class=\"strong\">Pierre</span> : Ok, est-ce que tu sais comment bien \u00e9crire une dissertation ?</br>\n<span class=\"strong\">Coraline</span> : J'ai beaucoup de documents qui peuvent t'\u00eatre utiles. Je te les enverrai par courriel.</br>\n<span class=\"strong\">Pierre</span> : Super ! Merci beaucoup. J'appr\u00e9cie vraiment ton aide.", "id": 3, "time": "23800", "image": "frn5le08ob08re2img06.jpg"}], "audiosrc": "frn5le08ob08re2aud01", "coverimg": "frn5le08ob08re2img06.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 3, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn5le08ob08re3img01.jpg"}, {"text": "Apprenons comment \u00e9crire une dissertation.", "id": 1, "time": "100", "image": "frn5le08ob08re3img02.jpg"}, {"text": "", "id": 2, "time": "1500", "image": "frn5le08ob08re3img03.jpg"}, {"text": "", "id": 3, "time": "4500", "image": "frn5le08ob08re3img04.jpg"}, {"text": "", "id": 4, "time": "6000", "image": "frn5le08ob08re3img05.jpg"}, {"text": "", "id": 5, "time": "11500", "image": "frn5le08ob08re3img04.jpg"}, {"text": "", "id": 6, "time": "21000", "image": "frn5le08ob08re3img06.jpg"}, {"text": "", "id": 7, "time": "34000", "image": "frn5le08ob08re3img07.jpg"}, {"text": "", "id": 8, "time": "42000", "image": "frn5le08ob08re3img08.jpg"}, {"text": "", "id": 9, "time": "65000", "image": "frn5le08ob08re3img09.jpg"}, {"text": "", "id": 10, "time": "80000", "image": "frn5le08ob08re3img10.jpg"}, {"text": "", "id": 11, "time": "90000", "image": "frn5le08ob08re3img01.jpg"}], "audiosrc": "frn5le08ob08re3aud01", "coverimg": "frn5le08ob08re3img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Pierre se pr\u00e9pare pour ses examens finaux", "type": "lesson_name"}, {"content": "\u00c9crivons ! \u00c9crire le travail final", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant identifie et d\u00e9crit des plans concernant l'organisation d'\u00e9v\u00e9nements.", "type": "primary"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_1"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_2"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_3"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_4"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_5"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_6"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_7"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs quotidiens relatifs \u00e0 ce niveau.", "type": "secondary_8"}]}, {"content": "frn5le08ob08re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "R\u00e9diger une dissertation", "type": "heading"}, {"content": " Une dissertation comprend : ", "type": "describer"}, {"content": "<ul><li>Une introduction : L'introduction commence par une mise en contexte et pr\u00e9sente ensuite le sujet sur lequel porte la dissertation. </il></ul>", "type": "text"}, {"content": "<ul><li>Une th\u00e8se : L'introduction doit pr\u00e9senter de mani\u00e8re claire votre th\u00e8se. Chaque paragraphe doit porter sur un aspect diff\u00e9rent de votre th\u00e8se.</il></ul>", "type": "text"}, {"content": "<ul><li>Le corps du texte : Une dissertation comporte g\u00e9n\u00e9ralement trois paragraphes. Chaque paragraphe d\u00e9veloppe une id\u00e9e et s'accompagne d'exemples pr\u00e9cis pour souligner les id\u00e9es que vous exposez. </il></ul>", "type": "text"}, {"content": "<ul><li>La phrase d'introduction : Chaque paragraphe commence par une phrase d'introduction qui pr\u00e9sente l'id\u00e9e qui va \u00eatre d\u00e9velopp\u00e9e. Elle doit \u00e9noncer clairement l'argument. </il></ul>", "type": "text"}, {"content": "<ul><li>L'argumentation : On utilise des arguments (donn\u00e9es, citations, exemples, faits, etc.) pour d\u00e9fendre sa prise de position. Chaque phrase de d\u00e9veloppement doit comporter au moins 3 arguments. </il></ul>", "type": "text"}, {"content": "<ul><li>Une conclusion : Une conclusion offre un r\u00e9sum\u00e9 de votre r\u00e9flexion et un \u00e9largissement du sujet. </il></ul>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "lib\u00e9rer", "type": "name"}, {"content": "enlever ce qui g\u00eane ", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Va te balader au parc et lib\u00e8re-toi l'esprit.", "type": "example"}, {"content": "frn5le08ob08aud04", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous utilisez dans une discussion sur les cours. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "avoir l'air contrari\u00e9", "type": "name"}, {"content": "m\u00e9content ", "type": "definition"}, {"content": "(locution)", "type": "part_speech"}, {"content": "Exemple : Il a l'air contrari\u00e9. ", "type": "example"}, {"content": "frn5le08ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cruellement ", "type": "name"}, {"content": "de fa\u00e7on cruelle", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Je manque cruellement de temps. ", "type": "example"}, {"content": "frn5le08ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la dissertation", "type": "name"}, {"content": "une r\u00e9daction organis\u00e9e consistant \u00e0 discuter d'un sujet de litt\u00e9rature, d'histoire ou de philosophie", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : J'ai une dissertation \u00e0 finir pour l'un de mes cours. ", "type": "example"}, {"content": "frn5le08ob08aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "prendre soin ", "type": "name"}, {"content": "pr\u00eater une attention toute particuli\u00e8re \u00e0 quelque chose ou quelqu'un", "type": "definition"}, {"content": "(locution)", "type": "part_speech"}, {"content": "Exemple : Il faut que tu prennes soin de toi. ", "type": "example"}, {"content": "frn5le08ob08aud03", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "Je trouve une dissertation en fran\u00e7ais sur Internet. ", "type": "text"}, {"content": "Je compl\u00e8te le tableau. ", "type": "text"}, {"content": "Je pr\u00e9sente les points principaux de la dissertation \u00e0 un(e) camarade. ", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Allez sur Internet. ", "type": "text"}, {"content": "Trouvez une courte dissertation en fran\u00e7ais sur le sujet de votre choix. ", "type": "text"}, {"content": "Lisez la dissertation. ", "type": "text"}, {"content": "Compl\u00e9tez le tableau ci-dessous. ", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sujet\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Th\u00e8se\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sur quoi porte le premier paragraphe ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/><br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sur quoi porte le deuxi\u00e8me paragraphe ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/><br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sur quoi porte le troisi\u00e8me paragraphe ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/><br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Que comporte la conclusion ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Quels exemples permettent de d\u00e9fendre vos id\u00e9es ? \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br/>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}]}], "type": "sena"}